{
  "name": "expo-tailscale-check",
  "version": "0.1.0",
  "description": "Detect Tailscale usage in Expo and React Native apps",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "build",
    "ios",
    "android/src",
    "android/build.gradle",
    "src",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "expo",
    "react-native",
    "tailscale",
    "vpn",
    "exit-node",
    "split-tunnel",
    "network",
    "detection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xicko/expo-tailscale-check.git"
  },
  "bugs": {
    "url": "https://github.com/xicko/expo-tailscale-check/issues"
  },
  "author": "xicko <contact@dashnyam.com> (https://github.com/xicko)",
  "license": "MIT",
  "homepage": "https://github.com/xicko/expo-tailscale-check#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~54.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "passWithNoTests": true,
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=54.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.81.0"
  }
}
